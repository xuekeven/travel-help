{
  "manifest_version": 3,
  "name": "12306 买票助手",
  "version": "1.0.0",
  "description": "自动同步候补订单到本地助手服务",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://kyfw.12306.cn/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kyfw.12306.cn/otn/view/lineUp_order.html",
        "https://kyfw.12306.cn/otn/view/train_order.html",
        "https://kyfw.12306.cn/otn/queryOrder/*",
        "https://kyfw.12306.cn/otn/afterNate*",
        "https://kyfw.12306.cn/otn/afterNateOrder*"
      ],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kyfw.12306.cn/otn/view/lineUp_order.html",
        "https://kyfw.12306.cn/otn/view/train_order.html",
        "https://kyfw.12306.cn/otn/queryOrder/*",
        "https://kyfw.12306.cn/otn/afterNate*",
        "https://kyfw.12306.cn/otn/afterNateOrder*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "12306 买票助手",
    "default_icon": "icons/icon48.png",
    "default_popup": "popup.html"
  }
}
